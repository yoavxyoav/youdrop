{
  "manifest_version": 3,
  "name": "YouTube → AirDrop",
  "version": "1.0.0",
  "description": "Send the YouTube video you are watching, at its current timestamp, to your phone over AirDrop.",
  "permissions": ["scripting", "activeTab", "storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:7337/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AirDrop this moment to my phone",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "airdrop-current-moment": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "AirDrop the current YouTube moment"
    }
  }
}
